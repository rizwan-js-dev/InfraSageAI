# Copy to .env (gitignored) and replace every change-me value. Placeholders only — never commit real values.
# Used by docker compose AND the API. See docs/env.md for what each variable does and when it is used.

NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
LOCAL_DEV_USER=local-developer

# MySQL (docker compose). Passwords: 8-128 chars of [A-Za-z0-9_.~+=-].
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=infrasage
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_USER=infrasage_app
MYSQL_APP_PASSWORD=change-me-app
MYSQL_RO_USER=infrasage_ro
MYSQL_RO_PASSWORD=change-me-ro
MYSQL_MIGRATOR_USER=infrasage_migrator
MYSQL_MIGRATOR_PASSWORD=change-me-migrator

# Redis (docker compose maps REDIS_PORT on 127.0.0.1; keep REDIS_URL in sync).
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

PROVIDER_MODE=mock
LLM_MODE=mock
# Server-side only. Required only when LLM_MODE=openai. Never prefix with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_INPUT_TOKENS=12000
OPENAI_MAX_OUTPUT_TOKENS=2500

MCP_SERVER_ENTRY=services/mcp-server/dist/index.js
MCP_TOOL_TIMEOUT_MS=5000
MCP_MAX_CONCURRENT_CALLS=4
MCP_MAX_RANGE_MINUTES=360
MCP_MAX_SAMPLES=720

INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_MAX_HYPOTHESES=4
INVESTIGATION_MAX_DURATION_MS=60000
INVESTIGATION_COOLDOWN_SECONDS=300
DETECTOR_INTERVAL_MS=15000
STALE_AFTER_SECONDS=120
RETENTION_DAYS=14

HEALTH_CHECK_TIMEOUT_MS=1500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_MUTATING_MAX=30

LOG_LEVEL=info
# Only honoured when NODE_ENV=development.
LOG_PROMPTS=false
